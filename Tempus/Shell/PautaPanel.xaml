<Window x:Class="Tempus.Shell.PautaPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Tempus — Pauta"
        Width="440"
        MaxHeight="460"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <Border x:Name="Shell" BorderThickness="1" CornerRadius="8" Padding="0">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Cabeçalho: o nome da reunião, porque a pauta só existe em relação a ela -->
      <StackPanel Grid.Row="0" Margin="14,12,14,8">
        <TextBlock x:Name="HeaderText"
                   FontSize="14"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"
                   Text="Pauta" />
        <TextBlock x:Name="HeaderWhen"
                   FontSize="11"
                   Margin="0,1,0,0"
                   Text="" />
      </StackPanel>

      <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="0,0,0,4">
        <StackPanel x:Name="Items" Margin="8,0,8,0" />
      </ScrollViewer>

      <!-- Novo assunto -->
      <Border Grid.Row="2" x:Name="ComposerBorder" BorderThickness="0,1,0,0" Padding="14,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Grid Grid.Column="0">
            <TextBlock x:Name="Placeholder"
                       IsHitTestVisible="False"
                       VerticalAlignment="Center"
                       Text="Novo assunto… (Enter para incluir)" />
            <TextBox x:Name="NewItemBox"
                     BorderThickness="0"
                     Background="Transparent"
                     VerticalContentAlignment="Center"
                     Padding="0" />
          </Grid>

          <TextBlock x:Name="ComposerHint"
                     Grid.Column="1"
                     VerticalAlignment="Center"
                     Margin="8,0,0,0"
                     FontSize="11"
                     Text="Enter" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
