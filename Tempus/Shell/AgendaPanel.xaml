<Window x:Class="Tempus.Shell.AgendaPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Tempus — Agenda"
        Width="520"
        MaxHeight="560"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <Border x:Name="Shell" BorderThickness="1" CornerRadius="8">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="14,12,14,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Setas de dia (D-053). Ficam coladas no título porque é ele que elas mudam; do outro
             lado da barra o olho não ligaria as duas coisas. Somem no resumo, onde não há dia. -->
        <StackPanel x:Name="DayNav"
                    Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="-4,0,8,0"
                    Visibility="Collapsed">
          <TextBlock x:Name="PrevDay"
                     FontSize="16"
                     Padding="5,0,5,2"
                     Cursor="Hand"
                     ToolTip="Dia anterior"
                     Text="‹" />
          <TextBlock x:Name="NextDay"
                     FontSize="16"
                     Padding="5,0,5,2"
                     Cursor="Hand"
                     ToolTip="Próximo dia"
                     Text="›" />
        </StackPanel>

        <TextBlock x:Name="HeaderText"
                   Grid.Column="1"
                   FontSize="14"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Text="Agenda de hoje" />

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
          <TextBlock x:Name="HeaderCount" VerticalAlignment="Center" Text="" />

          <!-- Alterna entre a timeline de um dia e o resumo dos próximos (D-043). O rótulo diz
               para onde vai, não onde está: é o que permite ler o cabeçalho de uma vez. -->
          <TextBlock x:Name="HeaderLink"
                     VerticalAlignment="Center"
                     Margin="12,0,0,0"
                     Cursor="Hand"
                     Text="" />
        </StackPanel>
      </Grid>

      <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="0,0,0,10">
        <StackPanel x:Name="Timeline" Margin="8,0,8,0" />
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
