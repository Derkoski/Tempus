<Window x:Class="Tempus.Shell.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Configurações do Tempus"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <Window.Resources>
    <!-- As cores vêm de Palette em ApplyPalette, via DynamicResource: os controles padrão do WPF
         não herdam tema, e sem isto a tela fica texto escuro sobre painel escuro. -->
    <Style TargetType="TextBlock" x:Key="GroupTitle">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Margin" Value="0,18,0,8" />
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
    </Style>
    <Style TargetType="TextBlock" x:Key="Hint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="6,5" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource FieldBg}" />
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Fg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource FieldBg}" />
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Window.Resources>

  <Border x:Name="Shell" Padding="20,14,20,16">
    <StackPanel>

      <TextBlock Style="{StaticResource GroupTitle}" Margin="0,0,0,8" Text="Conta" />

      <TextBlock Text="E-mail" Margin="0,0,0,4" />
      <TextBox x:Name="EmailBox" />
      <TextBlock x:Name="EmailHint"
                 Style="{StaticResource Hint}"
                 Text="Pré-seleciona a conta na tela de consent do Google, que se repete toda semana." />
      <TextBlock x:Name="EmailError"
                 Style="{StaticResource Hint}"
                 Visibility="Collapsed"
                 FontWeight="SemiBold" />

      <TextBlock Style="{StaticResource GroupTitle}" Text="Expediente" />

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="14" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="10" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0">
          <TextBlock Text="Início" Margin="0,0,0,4" />
          <TextBox x:Name="StartBox" />
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="2">
          <TextBlock Text="Almoço" Margin="0,0,0,4" />
          <TextBox x:Name="MiddayBox" />
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="0">
          <TextBlock Text="Volta do almoço" Margin="0,0,0,4" />
          <TextBox x:Name="LunchEndBox" />
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="2">
          <TextBlock Text="Fim" Margin="0,0,0,4" />
          <TextBox x:Name="EndBox" />
        </StackPanel>
      </Grid>

      <TextBlock x:Name="WorkDayError"
                 Style="{StaticResource Hint}"
                 Visibility="Collapsed"
                 FontWeight="SemiBold" />

      <TextBlock Style="{StaticResource GroupTitle}" Text="Pausas de descanso" />

      <CheckBox x:Name="BreaksBox"
                Content="Reservar tempo para levantar da cadeira" />
      <TextBlock Style="{StaticResource Hint}"
                 Text="Encaixa uma pausa na manhã e outra à tarde, na janela livre mais próxima do meio de cada período. Ela se move sozinha se marcarem reunião em cima." />

      <StackPanel x:Name="BreakDurationRow"
                  Orientation="Horizontal"
                  Margin="0,10,0,0">
        <TextBlock Text="Duração" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox x:Name="BreakMinutesBox" Width="56" />
        <TextBlock Text="min" VerticalAlignment="Center" Margin="8,0,0,0" />
      </StackPanel>

      <Border x:Name="Divider" Height="1" Margin="0,20,0,14" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CancelButton"
                MinWidth="96"
                Padding="12,6"
                Margin="0,0,10,0"
                Content="Cancelar" />
        <Button x:Name="SaveButton"
                MinWidth="96"
                Padding="12,6"
                IsDefault="True"
                Content="Salvar" />
      </StackPanel>

    </StackPanel>
  </Border>
</Window>
